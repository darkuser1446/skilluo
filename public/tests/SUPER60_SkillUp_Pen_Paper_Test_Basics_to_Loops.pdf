(\(5 Marks\) Write the exact output of the program.) Tj
T* () Tj
T* (#include <iostream>) Tj
T* (using namespace std;) Tj
T* () Tj
T* (int main\(\) {) Tj
T* (    int total = 0;) Tj
T* (    for \(int i = 1; i <= 10; i++\) {) Tj
T* (        if \(i % 2 == 0\) continue;) Tj
T* (        if \(i > 7\) break;) Tj
T* (        for \(int j = 1; j <= i; j++\) {) Tj
T* (            if \(j % 3 == 0\) total += j;) Tj
T* (            else total -= 1;) Tj
T* (        }) Tj
T* (        cout << i << ":" << total << " ";) Tj
T* (    }) Tj
T* (    cout << endl << "Final: " << total;) Tj
T* (    return 0;) Tj
T* (}) Tj
