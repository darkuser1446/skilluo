[TEMPLATE]
DATABASE_URL="postgresql://username:password@ep-something.aws.neon.tech/neondb?sslmode=require"
# Required: schema.prisma uses directUrl for migrations. For Neon this is the
# non-pooled connection string (same host without the `-pooler` suffix).
DIRECT_URL="postgresql://username:password@ep-something.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="your_jwt_secret_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
