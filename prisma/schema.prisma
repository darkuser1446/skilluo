datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum WorkshopStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  SELECTED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  LATE
}

enum NoteCategory {
  NOTES
  PDF
  CODE
  RESOURCE
}

enum AssessmentType {
  TEST
  QUIZ
  PROGRAMMING
  ASSIGNMENT
}

enum DoubtStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(STUDENT)
  avatarUrl    String?
  phone        String?
  college      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  mentorProfile      MentorProfile?
  labMentors         LabMentor[]
  labStudents        LabStudent[]
  enrollments        WorkshopEnrollment[]
  submissions        Submission[]
  attendanceRecords  AttendanceRecord[]
  assessmentResults  AssessmentResult[]
  doubtsCreated      Doubt[]             @relation("StudentDoubts")
  doubtMessages      DoubtMessage[]
  feedbackGiven      Feedback[]          @relation("StudentFeedback")
  feedbackReceived   Feedback[]          @relation("MentorFeedback")
  exerciseSubmissions ExerciseSubmission[]
  notifications      Notification[]
}

model Workshop {
  id               String         @id @default(cuid())
  name             String
  year             Int            @unique
  slug             String         @unique
  startDate        DateTime
  endDate          DateTime
  status           WorkshopStatus @default(ACTIVE)
  evaluationConfig Json?          // e.g. { assignments: 30, assessments: 35, attendance: 15, exercises: 10, doubts: 5 }
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  labs        Lab[]
  enrollments WorkshopEnrollment[]
  sessions    Session[]
  assignments Assignment[]
  notes       Note[]
  assessments Assessment[]
  doubts      Doubt[]
  feedbacks   Feedback[]
  exercises   Exercise[]
  announcements Announcement[]
}

model Lab {
  id         String   @id @default(cuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  name       String
  schedule   String?
  capacity   Int      @default(30)
  createdAt  DateTime @default(now())

  mentors     LabMentor[]
  students    LabStudent[]
  sessions    Session[]
  assignments Assignment[]
  notes       Note[]
  assessments Assessment[]
  doubts      Doubt[]
  feedbacks   Feedback[]
  exercises   Exercise[]

  @@unique([workshopId, name])
}

model MentorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  company   String?
  specialty String?
  bio       String?
  createdAt DateTime @default(now())
}

model LabMentor {
  id       String  @id @default(cuid())
  labId    String
  lab      Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  mentorId String
  mentor   User    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  isLead   Boolean @default(false)

  @@unique([labId, mentorId])
}

model LabStudent {
  id         String   @id @default(cuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([labId, studentId])
}

model WorkshopEnrollment {
  id         String           @id @default(cuid())
  workshopId String
  workshop   Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ENROLLED)
  appliedAt  DateTime         @default(now())

  @@unique([workshopId, studentId])
}

model Session {
  id         String   @id @default(cuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId      String?
  lab        Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  title      String
  date       DateTime
  topic      String?
  createdAt  DateTime @default(now())

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  markedBy  String?
  createdAt DateTime         @default(now())

  @@unique([sessionId, studentId])
}

model Assignment {
  id            String   @id @default(cuid())
  workshopId    String
  workshop      Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId         String?
  lab           Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  title         String
  description   String
  dueDate       DateTime
  maxScore      Float    @default(100)
  attachmentUrl String?
  createdBy     String
  createdAt     DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String
  status       SubmissionStatus @default(SUBMITTED)
  score        Float?
  feedback     String?
  reviewedBy   String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
}

model Note {
  id          String       @id @default(cuid())
  workshopId  String
  workshop    Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId       String?
  lab         Lab?         @relation(fields: [labId], references: [id], onDelete: SetNull)
  title       String
  description String?
  content     String?
  fileUrl     String?
  category    NoteCategory @default(NOTES)
  tags        String[]
  uploadedBy  String
  createdAt   DateTime     @default(now())
}

model Assessment {
  id          String         @id @default(cuid())
  workshopId  String
  workshop    Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId       String?
  lab         Lab?           @relation(fields: [labId], references: [id], onDelete: SetNull)
  title       String
  type        AssessmentType @default(TEST)
  totalMarks  Float          @default(100)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime       @default(now())

  questions AssessmentQuestion[]
  results   AssessmentResult[]
}

model AssessmentQuestion {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  prompt        String
  options       Json?      // string[]
  correctAnswer String?
  marks         Float      @default(10)
}

model AssessmentResult {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  status       String     @default("COMPLETED")
  submittedAt  DateTime   @default(now())

  @@unique([assessmentId, studentId])
}

model Doubt {
  id          String      @id @default(cuid())
  workshopId  String
  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId       String
  lab         Lab         @relation(fields: [labId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation("StudentDoubts", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId    String?
  title       String
  description String
  status      DoubtStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  messages DoubtMessage[]
}

model DoubtMessage {
  id        String   @id @default(cuid())
  doubtId   String
  doubt     Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(cuid())
  workshopId  String
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentFeedback", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      User     @relation("MentorFeedback", fields: [mentorId], references: [id], onDelete: Cascade)
  rating      Int      // 1 to 5
  comment     String
  category    String   @default("GENERAL")
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([workshopId, studentId, mentorId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  performedBy String
  targetId    String?
  details     Json?
  createdAt   DateTime @default(now())
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

model Exercise {
  id               String             @id @default(cuid())
  workshopId       String
  workshop         Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId            String?
  lab              Lab?               @relation(fields: [labId], references: [id], onDelete: SetNull)
  title            String
  description      String
  problemStatement String
  difficulty       ExerciseDifficulty @default(MEDIUM)
  topic            String?
  examples         String?
  inputFormat      String?
  outputFormat     String?
  constraints      String?
  sampleInput      String?
  sampleOutput     String?
  dueDate          DateTime?
  maxScore         Float              @default(100)
  createdBy        String
  createdAt        DateTime           @default(now())

  submissions ExerciseSubmission[]
}

model ExerciseSubmission {
  id         String         @id @default(cuid())
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code       String
  language   String         @default("cpp")
  status     ExerciseStatus @default(SUBMITTED)
  score      Float?
  feedback   String?
  submittedAt DateTime      @default(now())

  @@unique([exerciseId, studentId])
}

model Announcement {
  id         String    @id @default(cuid())
  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  labId      String?
  title      String
  body       String
  isPublic   Boolean   @default(false)
  pinned     Boolean   @default(false)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
